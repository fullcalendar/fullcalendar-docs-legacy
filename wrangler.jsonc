{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fullcalendar-docs-legacy",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./_site",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "routes": [
    {
      "pattern": "legacy.fullcalendar.io",
      "custom_domain": true
    }
  ]
}
